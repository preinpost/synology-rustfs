[
   {
      "step_title": "RustFS configuration",
      "items": [
         {
            "type": "textfield",
            "desc": "Data shared folder. This must be a name for the shared folder only, without any path. This share is created at installation when it does not already exist.",
            "subitems": [
               {
                  "key": "wizard_data_directory",
                  "desc": "Data shared folder",
                  "defaultValue": "rustfs",
                  "validator": {
                     "allowBlank": false,
                     "regex": {
                        "expr": "/^[^<>: */?\"]*$/",
                        "errorText": "Share name must be a folder name only. Path separators, spaces and other special chars are not allowed."
                     }
                  }
               }
            ]
         },
         {
            "desc": "If you let the installer create the shared folder, it is created under the same volume as the package is installed. If you want to use a different volume for the share, you must create the shared folder in DSM Control Panel before, and enter the name of the existing share in the field above."
         },
         {
            "desc": "Define the RustFS administrator credentials. They are stored in files readable by the package service user only (mode 600). Do not use the public defaults (rustfsadmin)."
         },
         {
            "type": "textfield",
            "subitems": [
               {
                  "key": "wizard_access_key",
                  "desc": "Access key (user)",
                  "defaultValue": "",
                  "validator": {
                     "allowBlank": false,
                     "minLength": 3,
                     "maxLength": 128,
                     "regex": {
                        "expr": "/^[^=,\\s]*$/",
                        "errorText": "Characters '=', ',' and whitespace are not allowed."
                     }
                  }
               }
            ]
         },
         {
            "type": "password",
            "subitems": [
               {
                  "key": "wizard_secret_key",
                  "desc": "Secret key (password)",
                  "defaultValue": "",
                  "validator": {
                     "allowBlank": false,
                     "minLength": 8,
                     "regex": {
                        "expr": "/^[^=,\\s]*$/",
                        "errorText": "Characters '=', ',' and whitespace are not allowed."
                     }
                  }
               }
            ]
         }
      ]
   },
   {
      "step_title": "RustFS - Notes",
      "items": [
         {
            "desc": "S3 API port: 9200, Web console port: 9201."
         },
         {
            "desc": "Further settings can be changed in /var/packages/rustfs/var/environment-variables (restart the package afterwards)."
         },
         {
            "desc": "This is an unofficial package that is not provided by Synology, SynoCommunity or the RustFS project."
         }
      ]
   }
]
